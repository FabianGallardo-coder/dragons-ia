<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Configuración — Dragons & IA</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/static/css/style.css">
</head>
<body class="bg-gray-950 text-gray-100 min-h-screen flex items-center justify-center font-serif">

    <div class="w-full max-w-lg mx-auto px-4">
        <h1 class="text-3xl font-bold text-amber-400 text-center mb-8">⚙️ Configuración de IA</h1>

        <form id="config-form" class="space-y-5">
            <!-- Proveedor de IA -->
            <div>
                <label class="block text-gray-300 mb-1">Proveedor de IA</label>
                <select id="ai-provider"
                    class="w-full p-3 bg-gray-800 border border-gray-700 rounded-lg text-gray-100 focus:border-amber-500 focus:outline-none">
                    <option value="anthropic">Anthropic (Claude)</option>
                    <option value="ollama_cloud">Ollama Cloud</option>
                    <option value="ollama_local">Ollama (Local)</option>
                </select>
            </div>

            <!-- Modelo -->
            <div>
                <label class="block text-gray-300 mb-1">Modelo</label>
                <select id="ai-model"
                    class="w-full p-3 bg-gray-800 border border-gray-700 rounded-lg text-gray-100 focus:border-amber-500 focus:outline-none">
                </select>
                <input type="text" id="ai-model-custom" placeholder="Modelo personalizado (opcional)"
                    class="w-full p-3 mt-2 bg-gray-800 border border-gray-700 rounded-lg text-gray-100 focus:border-amber-500 focus:outline-none text-sm">
                <p id="model-help" class="text-gray-500 text-xs mt-1"></p>
            </div>

            <!-- API Key -->
            <div id="api-key-section">
                <label class="block text-gray-300 mb-1">API Key</label>
                <input type="password" id="api-key" placeholder="sk-..."
                    class="w-full p-3 bg-gray-800 border border-gray-700 rounded-lg text-gray-100 focus:border-amber-500 focus:outline-none">
                <p class="text-gray-500 text-xs mt-1">
                    Se guarda solo en tu navegador. Nunca se almacena en el servidor.
                </p>
            </div>

            <!-- Tutorial -->
            <div id="tutorial-box" class="bg-gray-900 border border-gray-700 rounded-lg p-4">
                <h3 class="text-amber-400 font-bold text-sm mb-2">📖 ¿Cómo obtener tu API Key?</h3>
                <div id="tutorial-content" class="text-gray-400 text-xs leading-relaxed space-y-2"></div>
            </div>

            <!-- Idioma -->
            <div>
                <label class="block text-gray-300 mb-1">Idioma de la aventura</label>
                <select id="language"
                    class="w-full p-3 bg-gray-800 border border-gray-700 rounded-lg text-gray-100 focus:border-amber-500 focus:outline-none">
                    <option value="es" selected>Español</option>
                    <option value="en">English</option>
                </select>
            </div>

            <button type="submit"
                class="w-full py-3 bg-amber-600 hover:bg-amber-500 text-white font-bold rounded-lg transition text-lg">
                💾 Guardar Configuración
            </button>
        </form>

        <div id="save-msg" class="text-emerald-400 text-center mt-4 hidden">
            ✓ Configuración guardada
        </div>

        <p class="text-center mt-6">
            <a href="/" class="text-gray-500 hover:text-gray-400 text-sm">← Volver al inicio</a>
        </p>
    </div>

    <script src="/static/js/api.js"></script>
    <script src="/static/js/auth.js"></script>
    <script>
        const MODELS = {
            anthropic: [
                { value: 'claude-sonnet-4-20250514', label: 'Claude Sonnet 4 (recomendado)' },
                { value: 'claude-3-5-haiku-20241022', label: 'Claude 3.5 Haiku (rápido)' },
                { value: 'claude-3-haiku-20240307', label: 'Claude 3 Haiku (económico)' },
            ],
            ollama_cloud: [
                { value: 'ollama/qwen3.5', label: 'Qwen 3.5 (recomendado)' },
                { value: 'ollama/nemotron-3-nano', label: 'Nemotron 3 Nano (liviano)' },
                { value: 'ollama/rnj-1:8b', label: 'Rnj-1 (8B)' },
                { value: 'ollama/devstral-small-2', label: 'Devstral Small 2 (24B)' },
            ],
            ollama_local: [], // Se llena dinámicamente desde /game/ollama/models
        };

        const HELP_TEXT = {
            anthropic: 'Necesitás una API Key de Anthropic. Obtené una en console.anthropic.com',
            ollama_cloud: 'Necesitás una API Key de Ollama Cloud. Obtené una en ollama.com/cloud',
            ollama_local: 'Ollama debe estar corriendo en tu PC. Sin API key necesaria.',
        };

        const PLACEHOLDER = {
            anthropic: 'sk-ant-...',
            ollama_cloud: 'Tu API key de Ollama Cloud',
            ollama_local: '',
        };

        const TUTORIALS = {
            anthropic: `
                <p class="font-semibold text-gray-300">Pasos para obtener tu API Key de Anthropic:</p>
                <ol class="list-decimal list-inside space-y-1 ml-1">
                    <li>Andá a <a href="https://console.anthropic.com/" target="_blank" class="text-amber-400 underline hover:text-amber-300">console.anthropic.com</a></li>
                    <li>Creá una cuenta o iniciá sesión</li>
                    <li>En el menú lateral, hacé clic en <strong class="text-gray-200">API Keys</strong></li>
                    <li>Clic en <strong class="text-gray-200">Create Key</strong></li>
                    <li>Copiá la key (empieza con <code class="bg-gray-800 px-1 rounded">sk-ant-...</code>) y pegala arriba</li>
                </ol>
                <p class="mt-2 text-yellow-500/80">⚠️ Anthropic requiere agregar créditos (mínimo ~$5 USD) para usar la API. Tienen un free tier muy limitado.</p>
                <p class="mt-1">💡 <strong class="text-gray-300">Recomendado:</strong> Claude 3 Haiku es el modelo más económico (~$0.25/millón de tokens).</p>
            `,
            ollama_cloud: `
                <p class="font-semibold text-gray-300">Pasos para obtener tu API Key de Ollama Cloud:</p>
                <ol class="list-decimal list-inside space-y-1 ml-1">
                    <li>Andá a <a href="https://ollama.com/" target="_blank" class="text-amber-400 underline hover:text-amber-300">ollama.com</a></li>
                    <li>Hacé clic en <strong class="text-gray-200">Sign In</strong> (arriba a la derecha)</li>
                    <li>Creá una cuenta con Google o GitHub</li>
                    <li>Una vez logueado, andá a <a href="https://ollama.com/settings/keys" target="_blank" class="text-amber-400 underline hover:text-amber-300">ollama.com/settings/keys</a></li>
                    <li>Clic en <strong class="text-gray-200">New API Key</strong></li>
                    <li>Ponele un nombre (ej: "dragons-ia") y copiá la key generada</li>
                    <li>Pegala arriba en el campo API Key</li>
                </ol>
                <p class="mt-2">💡 <strong class="text-gray-300">Recomendado:</strong> Gemma 4 — excelente para rol y narrativa.</p>
            `,
            ollama_local: `
                <p class="font-semibold text-gray-300">Pasos para usar Ollama en tu PC (sin API key):</p>
                <ol class="list-decimal list-inside space-y-1 ml-1">
                    <li>Descargá Ollama desde <a href="https://ollama.com/download" target="_blank" class="text-amber-400 underline hover:text-amber-300">ollama.com/download</a></li>
                    <li>Instalá y ejecutá Ollama</li>
                    <li>Abrí una terminal (CMD o PowerShell) y ejecutá:</li>
                </ol>
                <div class="bg-gray-800 rounded p-2 mt-2 font-mono text-xs">
                    <p class="text-green-400">$ ollama pull llama3</p>
                    <p class="text-gray-500 mt-1"># Esto descarga el modelo (~4.7 GB)</p>
                    <p class="text-gray-500"># Una vez descargado, el juego lo usará automáticamente</p>
                </div>
                <p class="mt-2">Para otros modelos:</p>
                <div class="bg-gray-800 rounded p-2 mt-1 font-mono text-xs space-y-1">
                    <p class="text-green-400">$ ollama pull mistral</p>
                    <p class="text-green-400">$ ollama pull gemma2</p>
                    <p class="text-green-400">$ ollama pull phi3</p>
                </div>
                <p class="mt-2 text-yellow-500/80">⚠️ Ollama debe estar corriendo mientras jugás. Verificá con:</p>
                <div class="bg-gray-800 rounded p-2 mt-1 font-mono text-xs">
                    <p class="text-green-400">$ ollama list</p>
                    <p class="text-gray-500"># Debería mostrar los modelos descargados</p>
                </div>
                <p class="mt-2">💡 <strong class="text-gray-300">Requisitos:</strong> Mínimo 8 GB de RAM. Para modelos grandes (70B), 32 GB+.</p>
            `,
        };

        async function updateModels(provider) {
            const select = document.getElementById('ai-model');
            select.innerHTML = '';
            document.getElementById('model-help').textContent = HELP_TEXT[provider] || '';
            document.getElementById('api-key').placeholder = PLACEHOLDER[provider] || 'API Key';

            // Ocultar API key para Ollama local
            document.getElementById('api-key-section').style.display =
                provider === 'ollama_local' ? 'none' : 'block';

            // Actualizar tutorial
            const tutorialBox = document.getElementById('tutorial-box');
            const tutorialTitle = tutorialBox.querySelector('h3');
            document.getElementById('tutorial-content').innerHTML = TUTORIALS[provider] || '';
            tutorialTitle.textContent = provider === 'ollama_local'
                ? '📖 ¿Cómo instalar Ollama en tu PC?'
                : '📖 ¿Cómo obtener tu API Key?';

            // Si es Ollama Local, fetch modelos instalados
            if (provider === 'ollama_local') {
                select.innerHTML = '<option value="">⏳ Cargando modelos...</option>';
                try {
                    const resp = await fetch('/game/ollama/models');
                    if (!resp.ok) throw new Error('No se pudo conectar a Ollama');
                    const models = await resp.json();
                    MODELS.ollama_local = models;
                    select.innerHTML = '';
                    if (models.length === 0) {
                        select.innerHTML = '<option value="">⚠️ No hay modelos instalados. Ejecutá: ollama pull llama3</option>';
                    } else {
                        models.forEach(m => {
                            const opt = document.createElement('option');
                            opt.value = m.value;
                            opt.textContent = m.label;
                            select.appendChild(opt);
                        });
                    }
                } catch (err) {
                    select.innerHTML = `<option value="">❌ Error: ${err.message}. ¿Ollama corriendo?</option>`;
                }
            } else {
                (MODELS[provider] || []).forEach(m => {
                    const opt = document.createElement('option');
                    opt.value = m.value;
                    opt.textContent = m.label;
                    select.appendChild(opt);
                });
            }
        }

        // Cargar config guardada
        document.addEventListener('DOMContentLoaded', () => {
            requireAuth();
            const config = getGameConfig();

            const providerEl = document.getElementById('ai-provider');
            if (config.provider) providerEl.value = config.provider;
            updateModels(providerEl.value);

            if (config.model) {
                const select = document.getElementById('ai-model');
                // Si el modelo guardado existe en la lista, seleccionarlo
                const exists = Array.from(select.options).some(o => o.value === config.model);
                if (exists) {
                    select.value = config.model;
                } else {
                    // Solo poner en custom si es realmente un modelo personalizado,
                    // no un modelo obsoleto de la lista anterior
                    const isKnownPrefix = Object.values(MODELS).flat().some(m =>
                        config.model.startsWith('ollama/') || config.model.startsWith('claude')
                    );
                    if (!isKnownPrefix) {
                        document.getElementById('ai-model-custom').value = config.model;
                    }
                    // Si era un modelo conocido pero ya no existe, limpiar la config guardada
                }
            }
            if (config.apiKey) document.getElementById('api-key').value = config.apiKey;
            if (config.language) document.getElementById('language').value = config.language;

            providerEl.addEventListener('change', (e) => {
                updateModels(e.target.value);
            });
        });

        document.getElementById('config-form').addEventListener('submit', (e) => {
            e.preventDefault();
            const customModel = document.getElementById('ai-model-custom').value.trim();
            const config = {
                provider: document.getElementById('ai-provider').value,
                model: customModel || document.getElementById('ai-model').value,
                apiKey: document.getElementById('api-key').value,
                language: document.getElementById('language').value,
            };
            saveGameConfig(config);

            const msg = document.getElementById('save-msg');
            msg.classList.remove('hidden');
            setTimeout(() => msg.classList.add('hidden'), 2000);
        });
    </script>
</body>
</html>

# Dragons & IA — Variables de entorno de ejemplo
# Copiá este archivo a .env y ajustá los valores

# --- Base de datos ---
DATABASE_URL=sqlite+aiosqlite:///./dragons_ia.db

# --- JWT (OBLIGATORIO en producción, mínimo 32 caracteres) ---
# En desarrollo se genera uno aleatorio si no se proporciona
JWT_SECRET_KEY=tu_clave_secreta_de_al_menos_32_caracteres_aqui
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# --- IA ---
# Default model for local Ollama (low resource usage)
DEFAULT_AI_MODEL=ollama/dolphin-mistral:7b-v2.6-dpo-laser-q4_K_M
ANTHROPIC_API_KEY=
OLLAMA_API_BASE=http://localhost:11434
OLLAMA_API_KEY=

# --- Servidor ---
HOST=0.0.0.0
PORT=8000
DEBUG=True
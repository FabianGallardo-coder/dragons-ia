# ════════════════════════════════════════════════
# Dragons & IA — Variables de entorno
# ════════════════════════════════════════════════
# Copia este archivo como .env y completa los valores

# --- Base de datos ---
# En desarrollo local se usa SQLite automáticamente.
# Para producción (Render), configurar PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dragons_ia
DATABASE_URL=sqlite+aiosqlite:///./dragons_ia.db

# --- JWT ---
JWT_SECRET_KEY=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# --- IA (LiteLLM) ---
# Modelo por defecto. Ejemplos: claude-3-haiku-20240307, ollama/llama3, ollama/mistral
DEFAULT_AI_MODEL=claude-3-haiku-20240307

# API Keys (solo la del proveedor que uses)
ANTHROPIC_API_KEY=

# Ollama Cloud (si usas modelos en la nube de Ollama)
OLLAMA_API_KEY=

# Ollama Local (solo si usas modelos locales en tu PC)
OLLAMA_API_BASE=http://localhost:11434

# --- Servidor ---
HOST=0.0.0.0
PORT=8000
DEBUG=true

